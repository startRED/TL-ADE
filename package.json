{
  "name": "tl-ade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ade": "bin/ade.js"
  },
  "scripts": {
    "lint": "node node_modules/oxlint/bin/oxlint src tests",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:parity": "set ADE_PARITY=1&& node node_modules/vitest/vitest.mjs run",
    "test:probes": "set ADE_PROBES=1&& node node_modules/vitest/vitest.mjs run",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "oxlint": "^1.83.0",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "canonicalize": "^5.0.0"
  }
}
