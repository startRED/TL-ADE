{
  "$id": "https://tl-ade.dev/schemas/journal-event.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "journal-event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "seq",
    "at",
    "prev",
    "kind",
    "effect_class",
    "input_digest",
    "intent_context",
    "worktree",
    "receipt_path",
    "session_ref",
    "runtime_stamp"
  ],
  "properties": {
    "format_version": { "type": "integer", "minimum": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "at": { "type": "string" },
    "prev": { "type": ["string", "null"] },
    "kind": { "type": "string", "minLength": 1 },
    "effect_class": { "type": "string", "minLength": 1 },
    "input_digest": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "intent_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "head_before": { "type": ["string", "null"] },
        "branch_before": { "type": ["string", "null"] },
        "head_after": { "type": ["string", "null"] },
        "branch_after": { "type": ["string", "null"] },
        "tree_before": { "type": ["string", "null"] },
        "parent_commit": { "type": ["string", "null"] },
        "remote_before": { "type": ["string", "null"] },
        "base_before": { "type": ["string", "null"] }
      }
    },
    "worktree": { "type": "string" },
    "receipt_path": { "type": "string" },
    "session_ref": { "type": ["string", "null"] },
    "runtime_stamp": { "type": "string", "pattern": "^[0-9]+:[0-9a-f]+:[0-9a-f]+$" },
    "step_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "data": { "type": "object" },
    "artifact_ref": { "type": "string" },
    "cache_hit": { "type": "boolean" },
    "workspace": { "type": "string" },
    "risk_escalated": { "type": "object" }
  }
}
